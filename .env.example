# Copie para .env (cp .env.example .env). O arquivo .env NÃO vai para o Git.

# --- Segurança (gateway) ---
JWT_SEGREDO=troque-este-segredo
JWT_EXPIRA_MINUTOS=30
USUARIOS=demo:demo123
RATE_LIMIT_POR_MINUTO=30
RATE_LIMIT_LOGIN=10
CONFIAR_PROXY=false

# --- Resiliência (gateway) ---
TIMEOUT_CONEXAO_S=1.5
TIMEOUT_LEITURA_S=5
RETRY_TENTATIVAS=3
RETRY_ESPERA_BASE_S=0.3
CB_FALHAS_LIMITE=5
CB_RESET_S=15

# --- Retenção de dados (LGPD) ---
RESULTADO_TTL_S=3600
DLQ_TTL_S=86400
VETORIAL_TTL_S=86400

# --- Worker ---
MAX_TENTATIVAS=3

# --- Observabilidade ---
OTEL_CONSOLE=false

# Domínio público (apenas deploy com HTTPS - docker-compose.prod.yml)
DOMINIO=localhost
